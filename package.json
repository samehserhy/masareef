{
  "name": "masareef-wallet",
  "version": "7.20.0",
  "description": "برنامج المصاريف اليومي — تطبيق أندرويد (Capacitor)",
  "private": true,
  "scripts": {
    "setup": "npm install && npx cap add android && node setup-android.mjs && npx cap sync android",
    "update": "npx cap sync android && node setup-android.mjs",
    "open": "npx cap open android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "optionalDependencies": {
    "@capacitor-community/contacts": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
